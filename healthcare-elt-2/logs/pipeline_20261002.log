INFO  : Executing command(queryId=hive_20261002190605_ab413116-1018-40c4-8ea8-27bfd61028d5): INSERT OVERWRITE TABLE patient_analytics
SELECT
p.patient_id,
p.patient_name,
p.city,
COUNT(v.visit_id) AS total_visits,
SUM(v.amount) AS total_spent
FROM patients_raw p
JOIN visits_raw v
ON p.patient_id = v.patient_id
GROUP BY
p.patient_id,
p.patient_name,
p.city
